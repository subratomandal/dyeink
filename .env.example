# DyeInk runs on Cloudflare. There are NO required env vars — the admin
# password and session secret live in D1, set during the first-run setup.
#
# All optional Worker secrets below are set with `wrangler secret put NAME`.

# ---------- Optional: skip the setup form ----------
# If set, the Worker seeds the admin row from this on first request.
# Skipping it means visitors land on a one-time setup wizard instead.
# Either path is fine.
#
# This seeds brand-new installs only. After setup it is ignored, so changing it
# is not a way to change the password — run `npm run admin:reset-password`.
APP_PASSWORD=

# ---------- Optional: custom R2 public domain ----------
# If you've attached a custom domain or bucket-level public domain in the R2
# dashboard, paste it here so uploaded image URLs return that domain.
# If unset, images are served back through the Worker at /img/<key>.
R2_PUBLIC_URL=

# ---------- Optional: analytics write mode ----------
# D1 aggregate counters stay on by default so the current admin Stats dashboard
# remains populated. The Worker can also write view/share events to Analytics
# Engine if you enable Analytics Engine in Cloudflare and add its binding to
# wrangler.toml later. Set this to "off" only if you no longer want D1 writes
# for public view/share events.
D1_HIT_ROLLUPS=on

# ---------- Optional: pin CORS to a specific origin ----------
# Default mirrors the request Origin header. Set this to lock the API down
# to a single domain (e.g. your custom domain).
FRONTEND_ORIGIN=

# ---------- Optional: newsletter email sending ----------
# Requires Cloudflare Email Service plus a [[send_email]] binding named EMAIL
# in wrangler.toml. SITE_URL is used only when no verified custom domain is
# saved in settings.
SITE_URL=
EMAIL_FROM=
EMAIL_FROM_NAME=DyeInk

# ---------- Optional: in-app Cloudflare custom domains ----------
# CLOUDFLARE_API_TOKEN should have Workers Scripts Edit and Zone Read.
# Add Zone DNS Edit if you want DyeInk to automatically repair missing DNS
# records for Cloudflare-managed domains.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ZONE_NAME=
CLOUDFLARE_WORKER_NAME=dyeink
CLOUDFLARE_WORKER_ENVIRONMENT=
CUSTOM_DOMAIN_TARGET=

# ---------- Frontend (only matters in `npm run dev`) ----------
# In production the SPA is served from the same Worker as the API, so this
# is `/api` and Just Works. Override only when running the SPA against a
# remote Worker during development.
VITE_API_BASE_URL=/api

# Optional. If public JSON artifacts are served directly from an R2 custom
# domain, set this at build time, for example https://content.example.com.
# Leave empty to use same-origin /public/*.json routes.
VITE_PUBLIC_CONTENT_URL=
