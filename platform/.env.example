# Frontend env (Vite). Most setups don't need this file at all in production
# because the static SPA is served by the same Worker that hosts the API
# (so requests go to /api on the same origin). Set this only when you want to
# point the dev server at a remote API.

# Base URL for API requests. Default '/api' (same origin) works in production.
VITE_API_BASE_URL=/api
