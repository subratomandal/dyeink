{
  "name": "dyeink",
  "private": true,
  "version": "4.0.0",
  "description": "A self-hostable, single-admin personal blog on Cloudflare Workers + D1 + R2.",
  "workspaces": [
    "platform",
    "backend"
  ],
  "scripts": {
    "dev": "cd platform && npm run dev",
    "dev:worker": "cd backend && npm run dev",
    "dev:all": "npm-run-all --parallel dev dev:worker",
    "build": "cd platform && npm run build",
    "build:worker": "cd backend && npm run build",
    "preview": "cd platform && npm run preview",
    "deploy": "cd backend && npm run deploy",
    "db:migrate": "cd backend && npm run db:migrate",
    "db:migrate:local": "cd backend && npm run db:migrate:local"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "wrangler": "^4.85.0"
  }
}
