{
  "name": "dyeink-backend",
  "version": "1.0.0",
  "description": "DyeInk Cloudflare Worker — Hono + D1 + R2, single-admin auth.",
  "main": "src/worker.ts",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply dyeink",
    "db:migrate:local": "wrangler d1 migrations apply dyeink --local",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.12.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260425.1",
    "typescript": "^5.9.3",
    "wrangler": "^3.114.17"
  }
}
