# DyeInk backend runs on Cloudflare Workers.
# There is no MongoDB, Auth0, Vercel, Express server, or PORT setting.
#
# Bindings are configured in wrangler.toml:
# - DB: Cloudflare D1
# - IMAGES: Cloudflare R2
# - ASSETS: Workers Static Assets
# - ANALYTICS: optional Workers Analytics Engine binding if enabled in account
#
# Optional Worker secrets/vars:

# Seed the first admin password and skip the setup form. New installs only;
# use `npm run admin:reset-password` to change the password later.
APP_PASSWORD=

# Public/custom R2 domain for uploaded image URLs.
# Use a custom domain for production. Avoid r2.dev for production traffic.
R2_PUBLIC_URL=

# Lock API CORS to one frontend origin. If unset, the Worker mirrors Origin.
FRONTEND_ORIGIN=

# Keep D1 aggregate counters for the existing admin Stats dashboard.
# Set to "off" only after replacing stats reads with another analytics backend.
D1_HIT_ROLLUPS=on

# Optional newsletter sending. Requires Cloudflare Email Service and an EMAIL
# send-email binding in wrangler.toml.
SITE_URL=
EMAIL_FROM=
EMAIL_FROM_NAME=DyeInk

# Optional in-app custom-domain automation.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ZONE_NAME=
CLOUDFLARE_WORKER_NAME=dyeink
CLOUDFLARE_WORKER_ENVIRONMENT=
CUSTOM_DOMAIN_TARGET=
