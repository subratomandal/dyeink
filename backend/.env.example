# DyeInk backend runs on Cloudflare Workers.
# There is no MongoDB, Auth0, Vercel, Express server, or PORT setting.
#
# Bindings are configured in wrangler.toml:
# - DB: Cloudflare D1
# - IMAGES: Cloudflare R2
# - ASSETS: Workers Static Assets
# - ANALYTICS: Workers Analytics Engine
#
# Optional Worker secrets/vars:

# Seed the first admin password and skip the setup form.
APP_PASSWORD=

# Public/custom R2 domain for uploaded image URLs.
# Use a custom domain for production. Avoid r2.dev for production traffic.
R2_PUBLIC_URL=

# Lock API CORS to one frontend origin. If unset, the Worker mirrors Origin.
FRONTEND_ORIGIN=

# Keep D1 aggregate counters for the existing admin Stats dashboard.
# Set to "off" only after replacing stats reads with Analytics Engine queries.
D1_HIT_ROLLUPS=on
